PORT=3651

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=doo_kbo
DB_SYNCHRONIZE=false
DB_LOGGING=false

SENTRY_DSN=

CACHE_TTL_MS=300000

# 네이버 스포츠 API 호출에 쓰는 Chromium/Chrome 실행 파일 경로.
# Docker 이미지에는 /usr/bin/chromium으로 설정돼 있으므로 로컬 실행 때만 주석을 풀어 채운다
# (빈 값으로 두면 compose의 env_file이 이미지 설정을 빈 값으로 덮어쓴다).
# CHROMIUM_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
